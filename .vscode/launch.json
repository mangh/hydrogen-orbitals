{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug",
            "program": "${workspaceFolder}/build/orbitals/orbitals.exe",
            "args": [
                "--principal", "4",
                "--angular", "3",
                "--magnetic", "1"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Visualize 2D",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/orbitals/visualize2d.py",
            "console": "integratedTerminal",
            "args": ["results/n4_l3_m1"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Visualize 3D",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/orbitals/visualize3d.py",
            "console": "integratedTerminal",
            "args": ["results/n4_l3_m1"],
            "cwd": "${workspaceFolder}"
        }
    ]
}